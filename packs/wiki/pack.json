{
  "schema": 2,
  "id": "wiki",
  "name": "程式 Wiki",
  "version": "2.0.0",
  "description": "cr-daily 每日 code review → curate 策展 → wiki 知識庫，附 stopic / ask / resolve / cr-planfix skill 與每日前置規劃器。skill 本體放 .agent/capabilities/skills/，claude / codex / opencode 共用（需 agent-env）。",
  "tags": ["wiki", "code-review", "knowledge"],
  "requires_packs": ["agent-env"],
  "requires_tools": [
    { "name": "git", "cmd": "git --version", "hint": "需要 git（cr_collect 讀 commit 歷史）" },
    { "name": "python", "cmd": "python --version", "hint": "需要 Python 3.8+（腳本只用標準庫）" }
  ],
  "params": [
    { "key": "project", "label": "專案名稱", "type": "string", "default": "{{dirname}}" },
    { "key": "code_roots", "label": "程式碼根目錄", "type": "list", "default": ["src"], "help": "repo 相對路徑，可多個" },
    { "key": "code_exts", "label": "收集副檔名", "type": "list", "default": [".cs", ".ts", ".tsx", ".js", ".mjs", ".py"] },
    { "key": "excludes", "label": "排除路徑片段", "type": "list", "default": ["/node_modules/", "/dist/", "/build/", "/plugins/", "/thirdparty/"] },
    { "key": "branch", "label": "預設 review 參照", "type": "string", "default": "HEAD", "help": "例 origin/main、origin/develop；自動化建議用遠端分支" }
  ],
  "presets": {
    "unity": {
      "label": "Unity (C#)",
      "values": {
        "code_roots": ["Assets/Scripts"],
        "code_exts": [".cs"],
        "excludes": ["/plugins/", "/thirdparty/", "/scripts/luban/", "/packages/", "/textmesh pro/"]
      }
    },
    "cocos": {
      "label": "Cocos Creator (TS)",
      "values": {
        "code_roots": ["assets/Script"],
        "code_exts": [".ts"],
        "excludes": ["/node_modules/", "/library/", "/temp/", "/build/", "/extensions/"]
      }
    },
    "web-ts": {
      "label": "Web / Node (TS/JS)",
      "values": {
        "code_roots": ["src"],
        "code_exts": [".ts", ".tsx", ".js", ".mjs", ".vue"],
        "excludes": ["/node_modules/", "/dist/", "/build/", "/.vite/", "/coverage/"]
      }
    },
    "python": {
      "label": "Python",
      "values": {
        "code_roots": ["src"],
        "code_exts": [".py"],
        "excludes": ["/.venv/", "/venv/", "/__pycache__/", "/build/", "/dist/"]
      }
    }
  },
  "legacy": [".claude/skills/cr-daily/", ".claude/skills/cr-planfix/", ".claude/skills/curate/", ".claude/skills/stopic/", ".claude/skills/ask/", ".claude/skills/resolve/", ".codex/skills/cr-daily/", ".codex/skills/cr-planfix/", ".codex/skills/curate/", ".codex/skills/stopic/", ".codex/skills/ask/", ".codex/skills/resolve/", ".claude/commands/curate.md", ".claude/commands/stopic.md", ".claude/commands/ask.md", ".claude/commands/resolve.md"],
  "skills": ["cr-daily", "cr-planfix", "curate", "stopic", "ask", "resolve"],
  "specs": [
    { "file": "wiki.md", "title": "Wiki 知識頁 / 狀態檔 / 權威分級", "load": "ondemand", "when": "跑 curate、resolve，或手動改 wiki/ 時" },
    { "file": "recon.md", "title": "工單偵察 SOP（wiki + codegraph 雙查詢）", "load": "auto", "mode": "seed", "when": "接到工單或需求、要定位 code 時：先 stopic 圈範圍，再用 codegraph 追符號，最後回 code 核對" }
  ],
  "files": [
    { "path": ".agent/scripts/build_index.py", "mode": "managed" },
    { "path": ".agent/scripts/daily_preflight.py", "mode": "managed" },
    { "path": ".agent/scripts/daily_preflight.bat", "mode": "managed" },
    { "path": ".agent/spec/modules.json", "mode": "seed" },
    { "path": ".agent/config.json", "source": "files/.agent/config.json.tmpl", "mode": "seed", "template": true },
    { "path": ".agent/codereview", "mode": "dir" },
    { "path": ".state/manifest.json", "mode": "seed" },
    { "path": ".state/features.json", "mode": "seed" },
    { "path": ".state/review_queue.json", "mode": "seed" },
    { "path": "raw/tickets", "mode": "dir" },
    { "path": "raw/spec", "mode": "dir" },
    { "path": "wiki/INDEX.md", "mode": "seed" },
    { "path": "AGENTS.md", "source": "blocks/AGENTS.md", "mode": "block" },
    { "path": ".gitignore", "source": "blocks/.gitignore", "mode": "block" }
  ],
  "post_install": []
}
